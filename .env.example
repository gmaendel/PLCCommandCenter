# Copy to .env (chmod 600) and fill in real values. .env is gitignored.
# scripts/install.sh does this for you and asks for the dashboard password.

# Password required on the dashboard to change settings / devices / tags
DASHBOARD_PASSWORD=replace-with-dashboard-password

# Telegram: easiest is the dashboard's Settings -> "Telegram alerts" card (paste the bot token,
# tap "Find my chat"). Values here are only a fallback used when the card has nothing saved.
# Several chat ids may be comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# iMessage group the alarms go to (can also be changed on the Settings page)
PLCCC_IMESSAGE_CHAT=PLC Alarms

# ── Optional overrides (defaults shown) ──
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=8085
# PUMP_PLC_HOST=…                  (legacy v1 pump_monitor.py only)
# PUMP_PLC_PORT=44818
# PLCCC_SEED_V1_DEVICES=1          add the original two demo devices to an empty database
# PLCCC_DATA_DIR=./data            (holds pump_data.db and pump_config.json)
# PLCCC_DB_PATH=./data/pump_data.db
# PLCCC_CONFIG_PATH=./data/pump_config.json

# ── v2 unified service (optional) ──
# PLCCC_DRY_RUN=1                 log alerts instead of sending them (testing only; install.sh refuses it)
# PLCCC_POLL_INTERVAL=60          seconds between polls of each device
# PLCCC_ACK_FILE=/tmp/pump_ack    touched by the dashboard 'Acknowledge' button / 'ack' replies
# PLCCC_WEB_THREADS=8
