<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.plccommandcenter.web</string>
    <!-- Dashboard (waitress, DASHBOARD_HOST:DASHBOARD_PORT from .env, default 0.0.0.0:8085).
         Separate process: a web crash never stops alarms and vice versa. -->
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-u</string>
        <string>__PROJECT_DIR__/app/plccc_web.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/plccc_web.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/plccc_web.error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PLCCC_LOG_FILE</key>
        <string>__PROJECT_DIR__/logs/plccc_web.log</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
